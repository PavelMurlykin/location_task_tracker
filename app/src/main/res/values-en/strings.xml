    <string name="privacy_title">Privacy</string>
    <string name="privacy_data_heading">Data used</string>
    <string name="privacy_data_text">Tasks, selected coordinates, and settings are stored locally on your device. This version has no accounts or proprietary server.</string>
    <string name="privacy_location_heading">Location</string>
    <string name="privacy_location_text">With your permission, the app uses precise location, including in the background when the app is closed or not in use. Android needs this to detect entry into a task location and show a reminder. Location history is not recorded.</string>
    <string name="privacy_control_heading">Data control</string>
    <string name="privacy_control_text">Location reminders can be disabled for each task. Permissions can be revoked in system settings. Clearing app data deletes local tasks and settings.</string>
